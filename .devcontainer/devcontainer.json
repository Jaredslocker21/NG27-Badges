{
  "name": "NG27 Badges",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "NG27 badge preview",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "postStartCommand": "python .devcontainer/start-preview.py"
}
